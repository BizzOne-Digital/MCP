# MongoDB (same cluster as your ecommerce sites)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net

# MCP database name on that cluster
MCP_DB_NAME=master_control_panel

# Panel login password (/login) — also used by npm run seed
MCP_PASSWORD=change-me

# Long random string (session cookies). Generate: openssl rand -base64 32
AUTH_SECRET=change-me

# Production (Vercel, VPS, etc.): set these in the host dashboard, not in the repo.
# After deploy: npm run seed (once) if using DB-backed admin login.
